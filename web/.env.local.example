# Copy to .env.local (gitignored) and fill in.

# Path to a GCP service-account JSON key with the Cloud Speech-to-Text API
# and Vertex AI API (aiplatform.googleapis.com) enabled. Used for
# alignment-based slide sync AND as the auth for Gemini calls (below) — both
# TTS and content-selection go through Vertex AI, not an AI-Studio API key.
GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/to/service-account-key.json

# GCP project id — routes Gemini calls (content selection + Gemini-TTS)
# through Vertex AI, billed against the project's Cloud Billing account
# instead of AI Studio's free-tier "10 requests/day per model" cap. If
# unset, content selection falls back to a deterministic tag/depth filter,
# but TTS requires this — there's no fallback voice provider wired.
GOOGLE_CLOUD_PROJECT=
# Vertex AI region. Defaults to us-central1 if unset.
GOOGLE_CLOUD_LOCATION=

# Supabase project — for intake responses, watch-tracking, notes, and generated
# video storage. Local video generation can use disk storage without Supabase;
# authenticated patient endpoints require a configured Supabase project.
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Public/anon key — required for the browser-side Supabase client (patient
# auth: sign up / log in). Unlike the service-role key above, this one is
# safe to expose client-side; RLS (patient_id = auth.uid()) is what actually
# restricts access, not secrecy of this key. Get it from Project Settings >
# API in the Supabase dashboard.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Supabase personal access token (Management API) — lets `npm run sync:schema`
# pull the live DB schema into web/supabase/schema.sql without a DB password.
# Generate at https://supabase.com/dashboard/account/tokens
SUPABASE_ACCESS_TOKEN=

# Shared passcode for nurse/care-team access (Phase 1 goal #7b). One value,
# shared across all nurses — no per-nurse accounts. Checked server-side only.
CARE_TEAM_PASSCODE=

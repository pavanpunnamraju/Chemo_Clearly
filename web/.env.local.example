# Copy to .env.local (gitignored) and fill in.

# Google Cloud TTS — path to a GCP service-account JSON key with the
# Cloud Text-to-Speech API enabled. Same credential the video-gen spike used.
GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/to/service-account-key.json

# Gemini API key (aistudio.google.com) — used for the agentic content-selection
# step (picks which pre-approved content to include, never generates prose).
# If unset, selection falls back to a deterministic tag/depth filter — the
# pipeline still runs, but the agentic step is unverified without this.
GEMINI_API_KEY=

# Supabase project — for intake responses, watch-tracking, notes, and generated
# video storage. If unset, these fall back to local-disk / in-memory storage so
# the pipeline stays runnable without a live project; not yet verified against
# a real Supabase instance.
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
